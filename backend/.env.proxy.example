# 代理配置环境变量模板
# 复制此文件为 .env 并填入实际值

# ========== 代理配置 ==========
# 是否启用代理（本地开发设为false，生产环境设为true）
PROXY_ENABLED=false

# B站专用代理（推荐使用此配置）
# 格式: http://username:password@proxy_host:port
# 示例: BILIBILI_PROXY=http://myuser:mypass@proxy.kuaidaili.com:8080
BILIBILI_PROXY=

# 通用静态代理（如果没有B站专用代理，使用此配置）
# 格式: http://username:password@proxy_host:port
STATIC_PROXY=

# 代理池API地址（可选，用于动态获取多个代理）
# 格式: 完整的API URL
# 示例: PROXY_API_URL=http://api.kuaidaili.com/free/getproxy?orderid=12345&num=10
PROXY_API_URL=

# ========== 代理服务商配置示例 ==========

# 快代理（推荐）
# 1. 访问 https://www.kuaidaili.com/
# 2. 购买15元/月套餐
# 3. 获取代理地址填入下方
# BILIBILI_PROXY=http://你的用户名:你的密码@proxy.kuaidaili.com:8080

# 阿布云
# 1. 访问 https://www.abuyun.com/
# 2. 购买动态代理套餐
# 3. 获取代理IP和端口
# BILIBILI_PROXY=http://你的IP:你的端口@proxy.abuyun.com:8080

# ========== 其他说明 ==========
# 本地开发: 保持 PROXY_ENABLED=false（不需要代理）
# 生产环境: 设置 PROXY_ENABLED=true 并配置代理地址
